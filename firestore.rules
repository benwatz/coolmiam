rules_version = '2';

// À publier dans la console Firebase : Firestore Database > Règles.
// Liste blanche : seuls les comptes dont l'UID a un document allowedUsers/{uid} accèdent à leurs données.
// Ce document se crée uniquement à la main dans la console (les clients ne peuvent pas y écrire).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isApproved() {
      return exists(/databases/$(database)/documents/allowedUsers/$(request.auth.uid));
    }

    // Un compte peut seulement vérifier sa propre approbation.
    match /allowedUsers/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Demande d'accès : un compte connecté écrit la sienne, que l'administrateur lit dans la console.
    match /accessRequests/{uid} {
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'name', 'requestedAt']);
      allow read, delete: if false;
    }

    // Repas et réglages : privés, par utilisateur approuvé.
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid) && isApproved();
    }
  }
}
